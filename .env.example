# Fill in once a Supabase project exists (https://supabase.com -> New project).
# Project Settings > API for the URL/anon key, Project Settings > Database
# for the connection string (use the "Transaction" pooler for DATABASE_URL).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Optional, only needed for the Google Takeout enrichment step
# (data/import/enrich-places.ts) that looks up address/phone/website
# for each imported location.
GOOGLE_PLACES_API_KEY=

# The site's public domain, used for metadata, sitemap.xml, and robots.txt.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# Fill in once a Sentry project exists (https://sentry.io -> New project,
# platform Next.js). Settings > Client Keys (DSN) for both DSN values (same
# value in both — NEXT_PUBLIC_SENTRY_DSN is the one the browser bundle reads).
# Error reporting works with just those two; SENTRY_ORG/PROJECT/AUTH_TOKEN
# are only needed to upload source maps (Settings > Auth Tokens, needs
# project:releases scope) so stack traces show your real source instead of
# minified code. Everything Sentry-related no-ops safely when left blank.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
